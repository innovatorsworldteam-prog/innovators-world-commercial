{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "innovators-world-commercial",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "innovators-world-commercial-db",
      "database_id": "fd8313c6-ceac-4112-a299-791169061dd1"
    }
  ]
}
